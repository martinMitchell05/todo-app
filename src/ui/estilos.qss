/* --- Tipografía global: una sola familia de fuente para toda la app --- */
* {
    font-family: "Segoe UI", "Helvetica Neue", "Inter", Arial, sans-serif;
}

/* --- Ventana Principal y Fondos --- */
QMainWindow {
    background-color: #10242f;
    
}

/* 1. Estilo base para TODOS los botones (estructura brutalista) */
QPushButton {
    color: white;
    background-color: #4278b5;
    font-weight: bold;
    font-size: 14px;
    border: 1px solid black;
    border-radius: 8px;
    padding: 10px;
}

/* Efecto global al presionar cualquier botón */
QPushButton:pressed {
    margin-top: 3px;
    margin-left: 3px;
}

/* Input principal: superficie oscura (la misma que las tarjetas) y borde lima al enfocar */
QLineEdit#task_input {
    background-color: #1B3340;
    color: #e8f0f4;
    font-family: "Space Mono";
    font-size: 14px;
    border: 2px solid #3d5a6a;
    border-radius: 14px;
    padding: 10px;
    margin: 4px;
    selection-background-color: #B2FA5C;
    selection-color: #10242f;
    placeholder-text-color: #7f99a6;
}

QLineEdit#task_input:focus {
    border: 2px solid #B2FA5C;
}

/* Botones de la barra superior: alineados con la paleta de las tarjetas (superficie + lima) */
QPushButton#tasks_button {
    background-color: #1B3340;
    color: #B2FA5C;
    border: 2px solid #B2FA5C;
}

QPushButton#tasks_button:hover {
    background-color: #B2FA5C;
    color: #10242f;
}

QPushButton#clear_button {
    background-color: #1B3340;
    color: #c8cce6;
    border: 2px solid #4a4a63;
}

QPushButton#clear_button:hover {
    border-color: #B2FA5C;
    color: white;
}

/* --- Ventana de 'Detail Window' --- */
QWidget#detail_window {
    background-color: #2c4a5a;
}

/* Badge de estado: color neutro por default, verde cuando completada="true" */
QLabel#estado_label {
    color: #242219;
    background-color: #c9c9c7;
    font-family: "Space Mono";
    font-size: 13px;
    font-weight: 700;
    border-radius: 12px;
    padding: 8px 14px;
}

QLabel#estado_label[completada="true"] {
    color: #1c6b1f;
    background-color: #cdeecb;
}

QLabel#label_desc {
    color: #d7dbdc;
    background-color: #373f48d3;
    font-family: "Space Mono";
    font-size: 16px;
    font-weight: 600;
    border-radius: 10px;
    text-align: center;
    margin: 5px 5px 5px 5px;
    /*padding: 8px 5px;*/
}

QLineEdit#desc_input {
    background-color: #5d6267be;
    color: #d7dbdc;
    border: 1px solid black;
    border-radius: 10px;
    text-align: center;
    padding: 10px 20px;
    margin: 5px 5px 5px 5px;
    font-size: 14px;
    font-weight: 300;
    font-family: "Space Mono";    
}

QLineEdit#desc_input:focus {
    border: 1px solid #858585;
    font-weight: 600;
}

QPushButton#save_button {
    background-color: #edc54a; 
    color: white; 
    font-weight: bold;
    border: none;
}

QPushButton#save_button:hover {
    background-color: #f7c42b;
    border: 2px dashed #68686887;
}

QPushButton#complete_button {
    background-color: #34b538; 
    color: white; 
    font-weight: bold;
    border: none;
}

QPushButton#complete_button:hover {
    background-color: #0ed615;
    border: 2px dashed #68686887;
}

QPushButton#delete_button {
    background-color: #c63f35; 
    color: white; 
    font-weight: bold;
    border: none;
}

QPushButton#delete_button:hover {
    background-color: #8d2f29;
    border: 2px dashed #68686887;
}

/* --- Sidebar --- */
QFrame#sidebar {
    background-color: #1c1c26;
    border-right: 3px solid black;
}

QLabel#logo_label {
    color: white;
    font-family: "Space Mono";
    font-size: 18px;
    font-weight: 800;
    padding: 0px 20px;
}

/* Botones de navegación: planos, sin el borde negro global */
QPushButton#nav_button {
    background-color: transparent;
    color: #c8cce6;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 10px 20px;
    margin: 2px 12px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#nav_button:hover {
    background-color: #2e2e42;
    color: white;
}

QPushButton#nav_button:checked {
    background-color: #B2FA5C;
    color: black;
}

QPushButton#new_task_button {
    background-color: #B2FA5C;
    color: black;
    border: 2px solid black;
    border-radius: 8px;
    padding: 12px;
    margin: 0px 16px;
    font-size: 14px;
}

QPushButton#new_task_button:hover {
    background-color: #c8ffa0;
}

/* Encabezado chico de la sección "LISTAS" dentro del sidebar */
QLabel#sidebar_section_label {
    color: #6b6f8f;
    font-family: "Space Mono";
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 20px 4px 20px;
}

/* Botón "+ Nueva lista": secundario, más discreto que "+ Nueva Tarea" */
QPushButton#new_list_button {
    background-color: transparent;
    font-family: "Space Mono";
    color: #c8cce6;
    border: 2px dashed #4a4a63;
    border-radius: 8px;
    padding: 8px 16px;
    margin: 6px 16px 0px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#new_list_button:hover {
    border-color: #B2FA5C;
    color: white;
}


/* --- Fix del Fondo del Scroll de Categorías --- */
QScrollArea#scroll_categorias {
    background-color: transparent;
    border: none;
}

/* El viewport interno que Qt crea automáticamente */
QScrollArea#scroll_categorias > QWidget > QWidget {
    background-color: transparent;
}

QWidget#categorias_container {
    background-color: transparent;
}

/* --- ScrollBar mejorado --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

/* La barrita que sube y baja (el handle) */
QScrollBar::handle:vertical {
    background-color: #4a4a63; 
    min-height: 30px;
    border-radius: 3px; 
}

QScrollBar::handle:horizontal {
    background-color: #4a4a63;
    max-height: 8px;
    min-width: 10px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B2FA5C; 
}

QScrollBar::handle:horizontal:hover {
    background-color: #B2FA5C; 
}

/* Ocultar las flechitas noventeras de los extremos */
QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-line:horizontal, 
QScrollBar::sub-line:horizontal {
    height: 0px;
    background: none;
    border: none;
}

/* Ocultar la pista por donde corre la barra */
QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar::add-page:horizontal, 
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* --- Header del área de contenido --- */
QFrame#header {
    background-color: transparent;
    border-bottom: 2px dashed #aeaeaece;
}

QLabel#header_title {
    color: #e8e8e8;
    font-family: "Space Mono";
    font-size: 22px;
    font-weight: 700;
    border: none;
}

QPushButton#filter_button {
    background-color: #1B3340;
    border: 2px solid #3d5a6a;
    font-size: 13px;
    padding: 8px 14px;
}

QPushButton#filter_button:checked {
    background-color: #B2FA5C;
    border-color: #B2FA5C;
}

/* --- Área de scroll de tarjetas ---
   Scopeado por selector (antes era un setStyleSheet inline sin selector en Python,
   que se propagaba a las tarjetas y les anulaba el borde y el fondo). */
QScrollArea#scroll_tareas {
    background-color: transparent;
    border: none;
}

/* El ">" limita la regla al contenedor interno; con espacio matchearía también las tarjetas */
QScrollArea#scroll_tareas > QWidget > QWidget {
    background-color: transparent;
}

/* Separador colapsable "-- Completadas (N) --" */
QPushButton#section_toggle {
    background-color: transparent;
    color: #B2FA5C;
    font-family: "Space Mono";
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    border: none;
    border-bottom: 2px dashed rgba(174, 174, 174, 160);
    border-radius: 0px;
    padding: 8px 4px;
    margin: 12px 0px 4px 0px;
}

QPushButton#section_toggle:hover {
    color: white;
}

QPushButton#section_toggle:pressed {
    margin: 12px 0px 4px 0px;  /* anula el "hundido" global de QPushButton:pressed */
}

/* --- Tarjeta de tarea (TaskCard) ---
   Opción A del rediseño: superficie un poco más clara que el fondo + borde lima de 2px.
   El estado se lee de la propiedad dinámica "completada" que setea TaskCard en Python. */
QFrame#task_card {
    background-color: #1B3340;
    border: 2px solid #B2FA5C;
    border-radius: 20px;
}

QFrame#task_card:hover {
    background-color: #21404f;
}

/* Completada: misma estructura pero "apagada" (no se usa QGraphicsOpacityEffect
   porque la tarjeta ya tiene el efecto de sombra y Qt permite uno solo por widget) */
QFrame#task_card[completada="true"] {
    background-color: #162a35;
    border: 2px solid #4f6b2f;
}

QFrame#task_card[completada="true"]:hover {
    background-color: #1B3340;
}

QLabel#task_desc {
    color: #f2f7f9;
    font-family: "Space Mono";
    font-size: 13px;
    font-weight: 400;
}

QLabel#task_desc[completada="true"] {
    color: #7f99a6;
    font-style: italic;
    text-decoration: line-through;
}

QLabel#task_id_label {
    color: #7fa3b5;
    font-family: "Space Mono";
    font-size: 11px;
}

/* Checkbox cuadrado de borde grueso. El tilde "✓" siempre está en el texto del botón,
   pero es transparente hasta que se tilda (así no hacen falta imágenes). */
QPushButton#task_check {
    background-color: transparent;
    color: transparent;
    border: 2px solid #B2FA5C;
    border-radius: 6px;
    padding: 0px;
    margin: 0px;
    font-size: 15px;
    font-weight: 900;
}

QPushButton#task_check:hover {
    color: rgba(178, 250, 92, 110);  /* adelanto del tilde al pasar el mouse */
}

QPushButton#task_check:checked {
    background-color: #B2FA5C;
    color: #10242f;
}

QPushButton#task_check:pressed {
    margin: 0px;  /* anula el "hundido" global de QPushButton:pressed */
}

/* Menú ⋮ de la tarjeta: texto plano, solo se ve en hover (lo controla TaskCard) */
QPushButton#task_menu {
    background-color: transparent;
    color: #7fa3b5;
    border: none;
    padding: 0px;
    margin: 0px;
    font-size: 18px;
    font-weight: 900;
}

QPushButton#task_menu:hover {
    color: #B2FA5C;
}

QPushButton#task_menu:pressed {
    margin: 0px;  /* anula el "hundido" global de QPushButton:pressed */
}

/* --- Panel de progreso (barra de caracteres + dato curioso) --- */
QLabel#progress_label {
    color: #B2FA5C;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#fact_button {
    background-color: transparent;
    color: #9fb3c0;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 12px;
    font-weight: 400;
    text-align: left;
    border: none;
    padding: 4px 0px;
    margin: 0px;
}

QPushButton#fact_button:hover {
    color: white;
}

QPushButton#fact_button:pressed {
    margin: 0px;
}

/* --- Estado vacío --- */
QFrame#empty_state {
    background-color: transparent;
    border: none;
}

QLabel#empty_art {
    color: #B2FA5C;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 15px;
    font-weight: 700;
}

QLabel#empty_tip {
    color: #7f99a6;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 12px;
}

/* --- Menús contextuales (tarjeta ⋮ y click derecho en listas) --- */
QMenu {
    background-color: #1B3340;
    color: #e8f0f4;
    border: 2px solid #B2FA5C;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #B2FA5C;
    color: #10242f;
}

QMenu::item:disabled {
    color: #5d7684;
}

QMenu::separator {
    height: 1px;
    background-color: #3d5a6a;
    margin: 4px 8px;
}

/* --- Diálogo Configuración > Temas --- */
QDialog#dialogo_temas {
    background-color: #2c4a5a;
}

QLabel#dialogo_titulo {
    color: #e8e8e8;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 16px;
    font-weight: 700;
}

QRadioButton#tema_radio {
    color: #f2f7f9;
    font-family: "Space Mono", "DejaVu Sans Mono", "Consolas", "Menlo", "Courier New", monospace;
    font-size: 14px;
    font-weight: 700;
    spacing: 10px;
}

QRadioButton#tema_radio::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #B2FA5C;
    border-radius: 9px;
    background-color: transparent;
}

QRadioButton#tema_radio::indicator:checked {
    background-color: #B2FA5C;
}

QLabel#tema_desc {
    color: #c8d6de;
    font-size: 12px;
    margin-left: 28px;
}

QPushButton#dialogo_cerrar {
    background-color: #B2FA5C;
    color: black;
    border: 2px solid black;
}

QPushButton#dialogo_cerrar:hover {
    background-color: #c8ffa0;
}
